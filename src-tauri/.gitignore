# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Tauri signing keys (keep private!)
*.key
*.key.pub

# 签名私钥密码(与 .key 配套,同样不能进仓库)
*.key.pass

# 本地运行数据库(含 token / api_key,严禁进仓库)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
